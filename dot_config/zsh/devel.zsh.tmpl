{{- /*-*- mode: sh -*-*/ -}}


{{ template "zsh/path-prepend.tmpl" "~/go/bin" }}

export ORGANIZATION={{ lower .org }}


# python
#
# We can't pip install into HomeBrew python so use pyenv to get a private python
# and then use venv to virtualize it. Just virtualizing the HomeBrew python
# still doesn't allow pip install to work. Further if it does work eventually
# HomeBrew will upgrade and delete the version our virtual environment is
# symbolic linked to.

export VIRTUAL_ENV_DISABLE_PROMPT=1

# requires pyenv (brew package)
# created with:
#
# pyenv install 3 -- builds the latest python 3 version into ~/.pyenv/versions
#

eval "$(pyenv init - zsh)"

# A ~/.venv/main virtual environment is not required as pip will now install
# into the ~/.pyenv installation of python.
#
# pyenv versions
# pyenv global <version>
# python -mvenv ~/.venv/main

{{ template "zsh/source.tmpl" "~/.venv/main/bin/activate" }}

{{- if eq .chezmoi.os "darwin" }}

# docker
#
# Setup path for either rancher, or docker desktop. Give priority to rancher.

{{ template "zsh/path-append.tmpl" "~/.rd/bin" }}
{{ template "zsh/path-append.tmpl" "~/.docker/bin" }}

# local AI

{{ template "zsh/path-append.tmpl" "~/.lmstudio/bin" }}
{{- end -}}

